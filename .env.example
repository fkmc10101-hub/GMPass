# ===== GMPass 환경변수 예시 =====
# 이 파일을 복사해 backend/.env 로 저장한 뒤 값을 채우세요. (.env 는 git에 올리지 않습니다)

# OpenAI — 비워 두면 dry-run 모드(검색 결과만 보여 주고 답변은 생성하지 않음)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# 임베딩 — sentence_transformers(실사용) / hash(테스트·오프라인용)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# 저장소
DATABASE_URL=sqlite:///./gmpass.db
# MySQL 예시: mysql+pymysql://user:password@host:3306/gmpass?ssl_verify_cert=true
CHROMA_DIR=../data/chroma
UPLOAD_DIR=../data/raw

# RAG 설정
TOP_K=5
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
MIN_RETRIEVAL_SCORE=0.35
SELF_CONSISTENCY_N=3
SELF_CONSISTENCY_THRESHOLD=0.75
CACHE_TTL_DAYS=7
# 한국어 GMP 용어에 영어·일본어 대응어를 덧붙여 검색 (rag/glossary.py)
QUERY_EXPANSION=true
# 의미 검색 + 키워드(BM25) 검색을 합쳐 사용 (rag/keyword.py)
HYBRID_SEARCH=true

# 문서 등록·삭제 보호용 토큰 (비워 두면 로컬에서 누구나 등록 가능)
ADMIN_TOKEN=

# 프론트엔드 주소 (CORS)
CORS_ORIGINS=http://localhost:5173

# Langfuse (선택) — 비워 두면 추적을 보내지 않음
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
